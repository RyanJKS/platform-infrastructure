
# This is a Terragrunt unit generated by Gruntwork Boilerplate (https://github.com/gruntwork-io/boilerplate).
terraform {
  source = "${include.repo_urls.locals.platform_blueprints_github_url}//terraform/azure/service_principal?ref=dev%2Fsandbox"
}

include "root" {
  path   = find_in_parent_folders("root.hcl")
  expose = true
}

include "repo_urls" {
  path   = "${dirname(find_in_parent_folders("root.hcl"))}/_envcommon/repo-urls.hcl"
  expose = true
}

dependency "solution_settings" {
  config_path = "../../solution_settings"

  mock_outputs = include.root.locals.mocks.solution_settings[include.root.locals.domain_name]

  mock_outputs_allowed_terraform_commands = include.root.locals.mocks.allowed_commands
  mock_outputs_merge_strategy_with_state  = "deep_map_only"
}

dependency "key_vault" {
  config_path = "../../keyvault"
}

dependency "aks_cluster" {
  config_path = "../cluster"
}

inputs = {
  # --------------------------------------------------------------------------------------------------------------------
  # Required input variables
  # --------------------------------------------------------------------------------------------------------------------

  # Description: The display name of the application and service principal. Used as the prefix for Key Vault secret names.
  # Type: string
  name = lower("argocd-sso-${include.root.locals.domain_name}${include.root.locals.region_short}${include.root.locals.environment}sp")


  # --------------------------------------------------------------------------------------------------------------------
  # Optional input variables
  # Uncomment the ones you wish to set
  # --------------------------------------------------------------------------------------------------------------------

  # Description: The object IDs of the owners of the application and service principal.
  # Type: set
  owners = [dependency.solution_settings.outputs.settings.object_id]

  # Description: Web redirect URIs for application sign-in callbacks, such as an Argo CD OIDC callback URL.
  # Type: set
  redirect_uris = [
    "http://localhost:8080/auth/callback",
    "https://argocd.jkslabs.site/auth/callback",
  ]

  # Description: Optional application federated identity credentials keyed by credential name. Each credential trusts an issuer and subject for the specified audiences.
  # Type: map
  federated_identity_credentials = {
    argocd-server = {
      issuer  = dependency.aks_cluster.outputs.oidc_issuer_url
      subject = "system:serviceaccount:argocd:argocd-server" # <namespace>:<name>
    }
  }

  # Description: Whether to create a service principal password and store its value and client ID in Key Vault.
  # Type: bool
  create_secret = true

  # Description: The resource ID of an existing Azure Key Vault. Required when create_secret is true.
  # Type: string
  key_vault_id = dependency.key_vault.outputs.id

}

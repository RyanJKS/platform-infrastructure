inputs = {
  # --------------------------------------------------------------------------------------------------------------------
  # Required input variables
  # --------------------------------------------------------------------------------------------------------------------

  # Description: Role assignments keyed by stable, caller-chosen names. Keys must be known at plan time; values may use dependency outputs.
  # Type: map
  assignments = {
    # # Grants the admin group full Kubernetes API access across the cluster
    aks_cluster_admin = {
      scope                = dependency.aks_cluster.outputs.id
      principal_id         = dependency.cluster_ad_groups.outputs.object_id["AKS-AGIC-ADMIN"]
      type                 = "Group"
      role_definition_name = "Azure Kubernetes Service RBAC Cluster Admin"
    },
    # Allows kublet for each pod to pull images!
    kubelet_acr = {
      scope                = dependency.container_registry.outputs.id
      principal_id         = dependency.kubelet_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "AcrPull"
    },
    agic_uami_subnet = {
      scope                = dependency.vnet.outputs.subnet_ids["agwsnet-001"]
      principal_id         = dependency.agic_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "Network Contributor"
    },
    # Both RBACS are required for agic uami as per docs: https://learn.microsoft.com/en-us/azure/application-gateway/ingress-controller-install-existing
    agic_agw = {
      scope                = dependency.application_gateway.outputs.id
      principal_id         = dependency.agic_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "Contributor"
    },
    agic_rg = {
      scope                = dependency.resource_group.outputs.id
      principal_id         = dependency.agic_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "Reader"
    },
    agic_agw_identity = {
      # Resource ID of the UAMI attached to Application Gateway
      scope                = dependency.agic_uami.outputs.id
      principal_id         = dependency.agic_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "Managed Identity Operator"
    },
    # both are required: https://kubernetes-sigs.github.io/external-dns/latest/docs/tutorials/azure/#managed-identity-using-workload-identity
    externaldns_network = {
      scope                = dependency.dns.outputs.id
      principal_id         = dependency.externaldns_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "DNS Zone Contributor"
    },
    externaldns_network_reader = {
      scope                = dependency.resource_group.outputs.id
      principal_id         = dependency.externaldns_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "Reader"
    },
    # Creates _acme-challenge TXT records for certificate validation. Not needed currently because of HTTP-01 but later for Azure DNS DNS-0
    certmanager_uami = {
      scope                = dependency.dns.outputs.id
      principal_id         = dependency.certmanager_uami.outputs.principal_id
      type                 = "ServicePrincipal"
      role_definition_name = "DNS Zone Contributor"
    },
  }


  # --------------------------------------------------------------------------------------------------------------------
  # Optional input variables
  # Uncomment the ones you wish to set
  # --------------------------------------------------------------------------------------------------------------------

}
